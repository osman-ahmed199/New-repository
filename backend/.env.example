# متغيرات البيئة لنظام الدعم الفني
# Environment Variables for Helpdesk System

# منفذ الخادم / Server Port
PORT=3000

# مفتاح JWT لتشفير التوثيق / JWT Secret Key
# استخدم قوة قوية وفريدة في الإنتاج
JWT_SECRET=helpdesk-secret-key-change-this-in-production

# رابط قاعدة البيانات / Database URL
DATABASE_URL=./database.db

# بيئة التشغيل / Environment (development/production)
NODE_ENV=development
